# ========================================================
# INOX Factory Shift Management System - Environment Variables Example
# Copy this file to .env or paste into Vercel Environment Variables
# ========================================================

# Server Configuration
NODE_ENV=production
PORT=5000

# MongoDB Database Connection
# For Local Development:
# MONGODB_URI=mongodb://127.0.0.1:27017/inox_factory_db
#
# For Vercel Production (MongoDB Atlas Free M0 Cluster):
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/inox_factory_db?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/inox_factory_db

# Security & Authentication Token Secret
JWT_SECRET=inox_secret_key_super_secure_jwt_token_2026

# Initial Administrator Credentials (auto-seeded on first run)
ADMIN_EMAIL=admin@inox.com
ADMIN_PASSWORD=admin123
